# Postgres connection string. Local: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=verbatim postgres:16
# Prod: your Neon connection string (keep ?sslmode=require on the end)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verbatim

# Signs access tokens and the OAuth session cookie. Required.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_SECRET=

# Origin the browser sees. Google redirects back to PUBLIC_URL/api/auth/google/callback
PUBLIC_URL=http://localhost:5173

# Optional: Google sign-in. Without these the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Free-tier key from https://aistudio.google.com/apikey — script generation
# returns 503 without it, everything else works fine regardless.
GEMINI_API_KEY=
# Optional override; defaults to gemini-flash-lite-latest if unset.
GEMINI_MODEL=
