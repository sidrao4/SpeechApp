# Postgres connection string. Local: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=verbatim postgres:16
# Prod: your Neon connection string (keep ?sslmode=require on the end)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verbatim
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Free-tier key from https://aistudio.google.com/apikey — script generation
# returns 503 without it, everything else works fine regardless.
GEMINI_API_KEY=
# Optional override; defaults to gemini-flash-latest if unset.
GEMINI_MODEL=
